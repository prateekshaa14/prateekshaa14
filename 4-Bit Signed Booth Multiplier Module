module booth_multiplier (
    input  wire clk,
    input  wire reset,
    input  wire start,
    input  wire signed [3:0] X,
    input  wire signed [3:0] Y,
    output reg  signed [7:0]  P,
    output reg  ready
);
    reg [1:0] state;
    reg [2:0] count;
    reg [3:0] M;
    reg [8:0] A_Q_q0;

    always @(posedge clk) begin
        if (reset) begin
            state <= 0;
            ready <= 1;
            P     <= 0;
            count <= 0;
        end else case (state)
            0: begin
                ready <= 1;
                if (start) begin
                    M       <= X;
                    A_Q_q0  <= {4'b0, Y, 1'b0};
                    count   <= 0;
                    ready   <= 0;
                    state   <= 1;
                end
            end
            1: begin
                if (A_Q_q0[1:0] == 2'b01)
                    A_Q_q0[8:5] <= A_Q_q0[8:5] + M;
                else if (A_Q_q0[1:0] == 2'b10)
                    A_Q_q0[8:5] <= A_Q_q0[8:5] - M;
                state <= 2;
            end
            2: begin
                A_Q_q0 <= $signed(A_Q_q0) >>> 1;
                count  <= count + 1;
                if (count == 3) state <= 3;
                else state <= 1;
            end
            3: begin
                P     <= A_Q_q0[8:1];
                ready <= 1;
                state <= 0;
            end
        endcase
    end
endmodule
