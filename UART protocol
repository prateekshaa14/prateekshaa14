module uart_top (
    input  wire clk,
    input  wire reset_n,
    output reg  uart_tx
);
    localparam CLK_PER_BIT = 868;
    
    wire reset = ~reset_n;
    reg [1:0]  state = 0;
    reg [15:0] count = 0;
    reg [2:0]  bit_idx = 0;
    wire [7:0] tx_data = 8'h41; 

    always @(posedge clk) begin
        if (reset) begin
            state   <= 0;
            uart_tx <= 1;
            count   <= 0;
            bit_idx <= 0;
        end else case (state)
            0: begin
                uart_tx <= 1;
                count   <= 0;
                bit_idx <= 0;
                state   <= 1;
            end
            1: begin
                uart_tx <= 0;
                if (count < CLK_PER_BIT - 1) begin
                    count <= count + 1;
                end else begin
                    count <= 0;
                    state <= 2;
                end
            end
            2: begin
                uart_tx <= tx_data[bit_idx];
                if (count < CLK_PER_BIT - 1) begin
                    count <= count + 1;
                end else begin
                    count <= 0;
                    if (bit_idx < 7) begin
                        bit_idx <= bit_idx + 1;
                    end else begin
                        state <= 3;
                    end
                end
            end
            3: begin
                uart_tx <= 1;
                if (count < CLK_PER_BIT - 1) begin
                    count <= count + 1;
                end else begin
                    state <= 0;
                end
            end
        endcase
    end
endmodule
